<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Anadolu Panteri</vendor>
  <vendor_url>https://anadolupanteri.org.tr</vendor_url>

  <!--
    The action is bound to /usr/libexec/kur-root, not /usr/bin/kur. pkexec
    authorises the exact path named below, and kur-root is the only entry point
    that restores the display environment pkexec strips. Pointing the action at
    /usr/bin/kur directly would authorise a program that cannot open a window.
  -->
  <action id="org.anadolupanteri.kur.run">
    <description>Run the BacakOS system installer</description>
    <description xml:lang="tr">BacakOS sistem yükleyicisini çalıştır</description>
    <message>Disklerinizi bölümlemek için yönetici yetkisi gerekiyor.</message>
    <message xml:lang="tr">Disklerinizi bölümlemek için yönetici yetkisi gerekiyor.</message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- Repartitioning is irreversible: authenticate, then keep the grant for
           the rest of this session so a retry does not prompt again. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kur-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
