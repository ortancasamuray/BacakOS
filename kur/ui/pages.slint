//
// The five wizard pages plus the sidebar row. Each page owns only its own
// widgets; `main.slint` wires their properties to the shell's.

import { Button, LineEdit, ComboBox, CheckBox, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { Theme, Card, Heading, Notice } from "theme.slint";
import { StepModel, DiskModel, PartitionModel, SegmentModel, GapModel, PlannedCreateModel } from "models.slint";

export component StepRow inherits Rectangle {
    in property <StepModel> step;
    in property <bool> active;
    in property <bool> reachable;

    height: 44px;
    border-radius: Theme.radius;
    background: active ? Theme.accent.with-alpha(0.16) : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Text {
            text: step.done ? "✓" : step.glyph;
            color: step.done ? Theme.success : (active ? Theme.accent : Theme.text-dim);
            font-size: 16px;
            vertical-alignment: center;
        }

        Text {
            text: step.title;
            // Unreachable steps are dimmed rather than hidden: the user should
            // always see how much is left.
            color: active ? Theme.text : (reachable ? Theme.text-dim : Theme.border);
            font-size: 14px;
            font-weight: active ? 700 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component LanguagePage inherits VerticalLayout {
    // ComboBox takes `[string]`, so Rust hands us the display labels flattened
    // out of its `Locale` list. `locale-index` indexes both identically.
    in property <[string]> locale-labels;
    in property <[string]> keymaps;
    in-out property <int> locale-index;
    in-out property <int> keymap-index;
    /// Fired after the locale changes, so Rust can re-derive keymap and zone.
    callback changed();

    spacing: Theme.gap;

    Heading {
        title: "Dil ve Klavye";
        subtitle: "Kurulum ve kurulacak sistem bu ayarları kullanacak.";
    }

    Text { text: "Sistem dili"; color: Theme.text-dim; font-size: 12px; }
    ComboBox {
        model: root.locale-labels;
        current-index <=> root.locale-index;
        selected => { root.changed(); }
    }

    Text { text: "Klavye düzeni"; color: Theme.text-dim; font-size: 12px; }
    ComboBox {
        model: root.keymaps;
        current-index <=> root.keymap-index;
    }

    Rectangle { vertical-stretch: 1; }
}

export component TimezonePage inherits VerticalLayout {
    /// Already filtered by Rust; `zone-index` indexes this visible list.
    in property <[string]> zones;
    in-out property <int> zone-index;
    in property <string> selected-zone;
    callback filter-changed(string);
    callback zone-selected(int);

    spacing: Theme.gap;

    Heading {
        title: "Saat Dilimi";
        subtitle: "Sistem saati bu dilime göre ayarlanacak.";
    }

    LineEdit {
        placeholder-text: "Ara — örn. Istanbul";
        edited(text) => { root.filter-changed(text); }
    }

    Card {
        vertical-stretch: 1;
        ScrollView {
            VerticalLayout {
                padding: 6px;
                for zone[i] in zones: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.zone-index ? Theme.accent.with-alpha(0.18) : transparent;

                    TouchArea { clicked => { root.zone-selected(i); } }

                    HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            text: zone;
                            color: i == root.zone-index ? Theme.accent : Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    Notice { text: "Seçili: " + root.selected-zone; kind: 0; }
}

/// The proportional, colour-coded strip showing how a disk's space is used —
/// existing partitions, planned deletions, free space and planned new
/// partitions, left to right in on-disk order.
export component DiskBar inherits Rectangle {
    in property <[SegmentModel]> segments;

    /// The colour a segment/role kind renders as. Indices mirror
    /// `MainWindow.partition-roles`: 0 unused, 1 root, 2 ESP, 3 swap, 4 delete.
    /// 5 is BIOS boot — not a combo-box option, so it has no `RoleChoice`
    /// index of its own; the automatic-plan renderer uses this one only.
    pure function role-color(kind: int) -> color {
        kind == 1 ? Theme.accent : (kind == 2 ? Theme.success : (kind == 3 ? Theme.warning : (kind == 4 ? Theme.danger : (kind == 5 ? Theme.boot : Theme.border))))
    }

    height: 40px;
    clip: true;
    border-radius: 6px;
    background: Theme.border;

    HorizontalLayout {
        spacing: 1px;
        for seg in segments: Rectangle {
            horizontal-stretch: Math.max(seg.fraction, 0.002);
            background: seg.is-free ? root.role-color(seg.role-kind).with-alpha(0.25) : root.role-color(seg.role-kind);
        }
    }
}

/// One free-space gap's inline "create a partition here" form.
component GapRow inherits Rectangle {
    in property <string> description;
    in property <[string]> create-roles;
    callback add(int, string);

    height: 36px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: description;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        combo := ComboBox {
            width: 150px;
            model: root.create-roles;
        }
        edit := LineEdit {
            width: 70px;
            placeholder-text: "GiB";
            input-type: InputType.decimal;
        }
        Button {
            text: "Ekle";
            enabled: edit.text != "";
            clicked => { root.add(combo.current-index, edit.text); }
        }
    }
}

export component DiskPage inherits VerticalLayout {
    in property <[DiskModel]> disks;
    in property <int> disk-index;
    in property <bool> manual-mode;
    in property <[PartitionModel]> partitions;
    in property <[string]> partition-roles;
    in property <[SegmentModel]> segments;
    in property <[GapModel]> gaps;
    in property <[string]> create-roles;
    in property <[PlannedCreateModel]> creates;
    in property <string> plan-error;

    callback disk-selected(int);
    callback manual-toggled(bool);
    callback role-changed(int, int);
    callback format-toggled(int, bool);
    callback create-partition(int, int, string);
    callback remove-create(int);

    spacing: 10px;

    Heading {
        title: "Disk Bölümleme";
        subtitle: root.manual-mode
            ? "Var olan bölümlere görev atayın. Yalnızca işaretlediğiniz bölümler biçimlendirilir."
            : "Otomatik kurulum seçili diski tamamen siler ve GPT + ESP + ext4 kök düzeni oluşturur.";
    }

    // --- Disk chooser. Shrinks to a fixed strip once the manual editor
    // appears, so the editor below has room; otherwise it fills the page.
    // `max-height` (not `height`) enforces the cap: a literal `height` binding
    // would override `vertical-stretch` and collapse the list in automatic
    // mode instead of letting it fill the available space.
    ScrollView {
        vertical-stretch: root.manual-mode ? 0 : 1;
        max-height: root.manual-mode ? 160px : 100000px;
        VerticalLayout {
            spacing: 8px;
            for disk[i] in disks: Card {
                height: 68px;
                border-color: i == root.disk-index ? Theme.accent : Theme.border;
                border-width: i == root.disk-index ? 2px : 1px;

                TouchArea {
                    // The live medium must never be an install target.
                    enabled: !disk.is-live-medium;
                    clicked => { root.disk-selected(i); }
                }

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: disk.path + "  ·  " + disk.model;
                            color: disk.is-live-medium ? Theme.text-dim : Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: disk.is-live-medium
                                ? disk.size-text + " — kurulum ortamı, kullanılamaz"
                                : disk.size-text + (disk.removable ? " — çıkarılabilir" : "");
                            color: disk.is-live-medium ? Theme.danger : Theme.text-dim;
                            font-size: 12px;
                        }
                    }

                    Text {
                        text: i == root.disk-index ? "●" : "○";
                        color: i == root.disk-index ? Theme.accent : Theme.border;
                        font-size: 18px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // --- Disk-bar preview: what the plan will do to the disk, in both modes.
    if disk-index >= 0: DiskBar { segments: root.segments; }

    if manual-mode: Card {
        vertical-stretch: 1;
        ScrollView {
            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                if partitions.length == 0 && gaps.length == 0: Text {
                    text: "Seçili diskte bölüm yok. Bir disk seçin.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                for part[i] in partitions: HorizontalLayout {
                    spacing: 10px;
                    height: 40px;

                    Text {
                        text: part.description;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    ComboBox {
                        width: 150px;
                        model: root.partition-roles;
                        current-index: part.role-index;
                        selected => { root.role-changed(i, self.current-index); }
                    }

                    CheckBox {
                        text: "Biçimlendir";
                        checked: part.format;
                        enabled: part.format-enabled;
                        toggled => { root.format-toggled(i, self.checked); }
                    }
                }

                if gaps.length > 0: Rectangle { height: 8px; }
                if gaps.length > 0: Text {
                    text: "Boş alanlar — yeni bölüm oluşturun";
                    color: Theme.text-dim;
                    font-size: 11px;
                }
                for gap[i] in gaps: GapRow {
                    description: gap.description;
                    create-roles: root.create-roles;
                    add(role-index, size-text) => { root.create-partition(i, role-index, size-text); }
                }

                if creates.length > 0: Rectangle { height: 8px; }
                if creates.length > 0: Text {
                    text: "Planlanan yeni bölümler";
                    color: Theme.text-dim;
                    font-size: 11px;
                }
                for c[i] in creates: HorizontalLayout {
                    height: 32px;
                    spacing: 10px;
                    Text {
                        text: c.description;
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Button {
                        text: "Kaldır";
                        clicked => { root.remove-create(i); }
                    }
                }
            }
        }
    }

    Notice { text: root.plan-error; kind: 2; }

    CheckBox {
        text: "Elle bölümleme (ileri düzey)";
        checked: root.manual-mode;
        toggled => { root.manual-toggled(self.checked); }
    }
}

export component UserPage inherits VerticalLayout {
    in-out property <string> hostname;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> password-confirm;
    in-out property <bool> root-same-password;

    /// 0..=4, computed in Rust by `backend::user::password_score`.
    in property <int> password-score;
    in property <string> validation-error;
    /// Fired on every keystroke; Rust re-runs `Account::validate`.
    callback changed();

    spacing: 10px;

    Heading {
        title: "Kullanıcı ve Sistem";
        subtitle: "Yönetici yetkisi (sudo) bu kullanıcıya verilecek.";
    }

    Text { text: "Bilgisayar adı"; color: Theme.text-dim; font-size: 12px; }
    LineEdit {
        placeholder-text: "bacakos";
        text <=> root.hostname;
        edited => { root.changed(); }
    }

    Text { text: "Kullanıcı adı"; color: Theme.text-dim; font-size: 12px; }
    LineEdit {
        placeholder-text: "kullanici";
        text <=> root.username;
        edited => { root.changed(); }
    }

    Text { text: "Parola"; color: Theme.text-dim; font-size: 12px; }
    LineEdit {
        input-type: InputType.password;
        text <=> root.password;
        edited => { root.changed(); }
    }

    // Strength meter: four segments filled according to `password-score`.
    HorizontalLayout {
        spacing: 4px;
        height: 4px;
        for seg[i] in [0, 1, 2, 3]: Rectangle {
            horizontal-stretch: 1;
            border-radius: 2px;
            background: root.password-score > i
                ? (root.password-score < 3 ? Theme.danger : Theme.success)
                : Theme.border;
        }
    }

    Text { text: "Parola (tekrar)"; color: Theme.text-dim; font-size: 12px; }
    LineEdit {
        input-type: InputType.password;
        text <=> root.password-confirm;
        edited => { root.changed(); }
    }

    CheckBox {
        text: "root parolası kullanıcı parolasıyla aynı olsun";
        checked <=> root.root-same-password;
    }

    Notice { text: root.validation-error; kind: 2; }
    Rectangle { vertical-stretch: 1; }
}

export component InstallPage inherits VerticalLayout {
    in property <bool> running;
    in property <bool> finished;
    in property <bool> failed;
    in property <float> progress;      // 0.0 ..= 1.0
    in property <string> stage-label;
    in property <string> log-tail;
    in property <string> summary;
    in property <bool> can-start;
    in property <string> blocked-reason;
    callback start();
    callback cancel();
    callback reboot();

    spacing: Theme.gap;

    Heading {
        title: finished ? "Kurulum Tamamlandı" : (failed ? "Kurulum Başarısız" : (running ? "Kuruluyor…" : "Özet"));
        subtitle: finished
            ? "Kurulum ortamını çıkarıp yeniden başlatabilirsiniz."
            : ((running || failed) ? stage-label : "Başlamadan önce seçimlerinizi gözden geçirin. Bu işlem geri alınamaz.");
    }

    if !running && !finished && !failed: VerticalLayout {
        vertical-stretch: 1;
        spacing: 10px;

        Notice { text: root.blocked-reason; kind: 2; }

        Card {
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    Text {
                        text: root.summary;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }
        }
    }

    // Kept visible after a failed install (not just while running/finished):
    // the log tail is the only place the actual failure reason survives —
    // `stage-label` above shows the one-line summary, this shows the detail.
    if running || finished || failed: VerticalLayout {
        vertical-stretch: 1;
        spacing: 10px;

        ProgressIndicator {
            height: 6px;
            progress: root.progress;
        }
        Text {
            text: Math.round(root.progress * 100) + "%";
            color: Theme.text-dim;
            font-size: 12px;
        }

        Card {
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    padding: 12px;
                    Text {
                        text: root.log-tail;
                        color: Theme.text-dim;
                        font-size: 11px;
                        font-family: "monospace";
                        wrap: no-wrap;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        Rectangle { horizontal-stretch: 1; }
        if !running && !finished: Button {
            text: root.failed ? "Yeniden Dene" : "Kurulumu Başlat";
            primary: true;
            enabled: root.can-start;
            clicked => { root.start(); }
        }
        if running: Button {
            text: "İptal";
            clicked => { root.cancel(); }
        }
        if finished: Button {
            text: "Yeniden Başlat";
            primary: true;
            clicked => { root.reboot(); }
        }
    }
}
