struct BtDevice {
    address: string,
    name: string,
    paired: bool,
    connected: bool,
    rssi: int,
    icon: string,
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 48px; height: 26px;
    border-radius: 13px;
    background: checked ? #4a9eff : #404055;
    animate background { duration: 180ms; }

    Rectangle {
        width: 20px; height: 20px; border-radius: 10px;
        background: white;
        x: checked ? 25px : 3px; y: 3px;
        animate x { duration: 180ms; easing: ease-in-out; }
        drop-shadow-blur: 2px; drop-shadow-color: #00000040;
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-text;
    in property <bool>   selected: false;
    callback clicked();

    height: 44px; border-radius: 8px;
    background: selected ? #ffffff18 : (touch.has-hover ? #ffffff0c : transparent);

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 10px; alignment: start;
        Text {
            text: icon-text; font-size: 16px; vertical-alignment: center;
            color: selected ? #4a9eff : #8b949e;
        }
        Text {
            text: label; font-size: 14px; vertical-alignment: center;
            color: selected ? #e6edf3 : #8b949e;
            font-weight: selected ? 600 : 400;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SectionLabel inherits Text {
    in property <string> label;
    text: label;
    font-size: 11px; font-weight: 700; color: #8b949e; letter-spacing: 1px;
}

component IconBtn inherits Rectangle {
    in property <string> label;
    in property <color>  btn-color: #4a9eff;
    in property <bool>   small: false;
    callback clicked();

    height: small ? 28px : 32px; border-radius: 6px;
    background: touch.has-hover ? btn-color.brighter(0.15) : btn-color;
    animate background { duration: 120ms; }

    Text {
        text: root.label; font-size: small ? 11px : 13px;
        color: white; horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component GhostBtn inherits Rectangle {
    in property <string> label;
    in property <color>  outline-color: #30363d;
    in property <bool>   small: false;
    callback clicked();

    height: small ? 28px : 32px; border-radius: 6px; border-width: 1px;
    border-color: touch.has-hover ? #8b949e : outline-color;
    background: touch.has-hover ? #ffffff0c : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.label; font-size: small ? 11px : 13px;
        color: touch.has-hover ? #e6edf3 : #8b949e;
        horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component PairedRow inherits Rectangle {
    in property <BtDevice> device;
    callback on-disconnect(); callback on-connect();
    callback on-forget();     callback on-send-file();

    height: 70px; border-radius: 8px;
    background: #ffffff08; border-width: 1px; border-color: #30363d;

    HorizontalLayout {
        padding: 12px; spacing: 10px; alignment: start;
        Rectangle {
            width: 36px; height: 36px; border-radius: 18px;
            background: device.connected ? #4a9eff22 : #30363d;
            Text {
                text: device.icon == "phone" ? "📱" : device.icon == "headset" ? "🎧" : device.icon == "computer" ? "💻" : "📶";
                font-size: 18px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text { text: device.name != "" ? device.name : device.address; font-size: 14px; color: #e6edf3; font-weight: 600; overflow: elide; }
            Text { text: device.connected ? "Bağlı" : "Bağlı değil"; font-size: 12px; color: device.connected ? #3fb950 : #8b949e; }
        }
        HorizontalLayout {
            alignment: end; spacing: 6px;
            if device.connected: IconBtn { label: "Dosya Gönder"; btn-color: #1f6feb; small: true; width: 100px; clicked => { root.on-send-file(); } }
            if device.connected: GhostBtn { label: "Kes"; small: true; width: 50px; clicked => { root.on-disconnect(); } }
            if !device.connected: GhostBtn { label: "Bağlan"; small: true; width: 60px; clicked => { root.on-connect(); } }
            GhostBtn { label: "Unut"; outline-color: #f8514933; small: true; width: 50px; clicked => { root.on-forget(); } }
        }
    }
}

component NearbyRow inherits Rectangle {
    in property <BtDevice> device;
    callback on-pair();

    height: 60px; border-radius: 8px;
    background: #ffffff06; border-width: 1px; border-color: #30363d;

    HorizontalLayout {
        padding: 12px; spacing: 10px; alignment: start;
        Rectangle {
            width: 36px; height: 36px; border-radius: 18px; background: #30363d;
            Text {
                text: device.icon == "phone" ? "📱" : device.icon == "headset" ? "🎧" : device.icon == "computer" ? "💻" : "📶";
                font-size: 18px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text { text: device.name != "" ? device.name : device.address; font-size: 14px; color: #e6edf3; overflow: elide; }
            Text { text: device.rssi != 0 ? device.rssi + " dBm" : ""; font-size: 12px; color: #8b949e; }
        }
        IconBtn { label: "Eşleş"; btn-color: #238636; small: true; width: 60px; clicked => { root.on-pair(); } }
    }
}

// Styled text input box
component InputBox inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> hint: "";
    background: #0d1117; border-radius: 6px; border-width: 1px; border-color: #30363d;
    height: 36px;

    if ti.text == "": Text {
        text: root.hint; font-size: 13px; color: #555566;
        x: 10px; y: 0; height: parent.height; vertical-alignment: center;
    }
    ti := TextInput {
        x: 10px; y: 0;
        width: parent.width - 20px; height: parent.height;
        font-size: 13px; color: #e6edf3; vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Ayarlar";
    min-width: 750px; min-height: 520px;
    background: #0d1117;
    preferred-width: 850px; preferred-height: 580px;

    in-out property <bool>       bt-powered: false;
    in-out property <bool>       bt-scanning: false;
    in-out property <[BtDevice]> paired-devices: [];
    in-out property <[BtDevice]> nearby-devices: [];

    in-out property <bool>   pairing-visible: false;
    in property <string>     pairing-device: "";
    in property <string>     pairing-passkey: "";

    in-out property <bool>   send-visible: false;
    in-out property <string> send-device-address: "";
    in-out property <string> send-file-path: "";

    in-out property <bool>   transfer-visible: false;
    in property <string>     transfer-file: "";
    in property <float>      transfer-progress: 0;
    in property <string>     transfer-status: "";

    in-out property <bool>   incoming-visible: false;
    in property <string>     incoming-device: "";
    in property <string>     incoming-file: "";

    in property <string>     toast-text: "";
    in-out property <bool>   toast-visible: false;

    callback toggle-bluetooth(bool);
    callback start-scan();
    callback stop-scan();
    callback pair-device(string);
    callback connect-device(string);
    callback disconnect-device(string);
    callback forget-device(string);
    callback send-file(string, string);
    callback confirm-pairing(bool);
    callback accept-incoming(bool);
    callback cancel-send();

    private property <string> current-panel: "bluetooth";

    HorizontalLayout {
        padding: 0px; spacing: 0px;

        // ─── Sidebar ──────────────────────────────────────────────
        Rectangle {
            width: 190px; background: #161b22;
            HorizontalLayout {
                padding: 0px;
                VerticalLayout {
                    padding: 16px; spacing: 4px; horizontal-stretch: 1;
                    Rectangle {
                        height: 48px;
                        Text { text: "Ayarlar"; font-size: 18px; font-weight: 700; color: #e6edf3; vertical-alignment: center; }
                    }
                    Rectangle { height: 8px; }
                    NavItem { label: "Bluetooth"; icon-text: "⬡"; selected: current-panel == "bluetooth"; clicked => { current-panel = "bluetooth"; } }
                    NavItem { label: "Ağ";        icon-text: "◈"; selected: false; clicked => { } }
                    NavItem { label: "Ses";       icon-text: "◉"; selected: false; clicked => { } }
                    NavItem { label: "Ekran";     icon-text: "◻"; selected: false; clicked => { } }
                }
                // Sağ kenar çizgisi
                Rectangle { width: 1px; background: #30363d; }
            }
        }

        // ─── İçerik ───────────────────────────────────────────────
        Rectangle {
            background: #0d1117; horizontal-stretch: 1;

            if current-panel == "bluetooth": VerticalLayout {
                padding: 24px; spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Bluetooth"; font-size: 22px; font-weight: 700; color: #e6edf3; vertical-alignment: center; }
                    ToggleSwitch { checked <=> bt-powered; toggled(on) => { root.toggle-bluetooth(on); } }
                }

                if bt-powered: VerticalLayout {
                    spacing: 20px;

                    HorizontalLayout {
                        alignment: start; spacing: 12px;
                        if !bt-scanning: IconBtn { label: "Cihaz Ara"; btn-color: #4a9eff; width: 110px; clicked => { root.start-scan(); } }
                        if bt-scanning: HorizontalLayout {
                            spacing: 8px;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #4a9eff; }
                            Text { text: "Aranıyor..."; color: #8b949e; font-size: 14px; vertical-alignment: center; }
                            GhostBtn { label: "Durdur"; width: 70px; clicked => { root.stop-scan(); } }
                        }
                    }

                    if paired-devices.length > 0: VerticalLayout {
                        spacing: 8px;
                        SectionLabel { label: "EŞLEŞMİŞ CİHAZLAR"; }
                        for dev[i] in paired-devices: PairedRow {
                            device: dev;
                            on-disconnect => { root.disconnect-device(dev.address); }
                            on-connect    => { root.connect-device(dev.address); }
                            on-forget     => { root.forget-device(dev.address); }
                            on-send-file  => {
                                root.send-device-address = dev.address;
                                root.send-file-path = "";
                                root.send-visible = true;
                            }
                        }
                    }

                    if nearby-devices.length > 0: VerticalLayout {
                        spacing: 8px;
                        SectionLabel { label: "YAKINDAKILER"; }
                        for dev[i] in nearby-devices: NearbyRow {
                            device: dev;
                            on-pair => { root.pair-device(dev.address); }
                        }
                    }

                    if paired-devices.length == 0 && nearby-devices.length == 0: Text {
                        text: bt-scanning ? "Cihazlar aranıyor..." : "Cihaz aramak için yukarıdaki butona tıklayın";
                        color: #8b949e; font-size: 14px; horizontal-alignment: center;
                    }
                }

                if !bt-powered: Text {
                    text: "Bluetooth kapalı";
                    color: #8b949e; font-size: 16px; horizontal-alignment: center;
                }
            }
        }
    }

    // ─── Eşleşme Onay Dialogu ─────────────────────────────────────
    if pairing-visible: Rectangle {
        background: #000000aa; x: 0; y: 0; width: root.width; height: root.height;
        Rectangle {
            width: 340px; height: 240px;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: #161b22; border-radius: 12px; border-width: 1px; border-color: #30363d;
            drop-shadow-blur: 24px; drop-shadow-color: #000000cc;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Text { text: "Eşleşme İsteği"; font-size: 17px; font-weight: 700; color: #e6edf3; horizontal-alignment: center; }
                Text { text: pairing-device; font-size: 14px; color: #8b949e; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    height: 52px; background: #0d1117; border-radius: 8px;
                    Text { text: pairing-passkey; font-size: 28px; font-weight: 700; color: #4a9eff; horizontal-alignment: center; vertical-alignment: center; letter-spacing: 6px; }
                }
                Text { text: "Telefonda aynı kodu onaylayın"; font-size: 12px; color: #8b949e; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostBtn { label: "Reddet"; outline-color: #f8514933; width: 130px; clicked => { root.confirm-pairing(false); root.pairing-visible = false; } }
                    IconBtn  { label: "Onayla";  btn-color: #238636;       width: 130px; clicked => { root.confirm-pairing(true);  root.pairing-visible = false; } }
                }
            }
        }
    }

    // ─── Dosya Gönder Dialogu ──────────────────────────────────────
    if send-visible: Rectangle {
        background: #000000aa; x: 0; y: 0; width: root.width; height: root.height;
        Rectangle {
            width: 420px; height: 180px;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: #161b22; border-radius: 12px; border-width: 1px; border-color: #30363d;
            drop-shadow-blur: 24px; drop-shadow-color: #000000cc;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Text { text: "Dosya Gönder"; font-size: 17px; font-weight: 700; color: #e6edf3; horizontal-alignment: center; }
                InputBox { text <=> send-file-path; hint: "Dosya yolu giriniz..."; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostBtn { label: "İptal";  width: 150px; clicked => { root.send-visible = false; root.cancel-send(); } }
                    IconBtn  { label: "Gönder"; btn-color: #1f6feb; width: 150px;
                        clicked => {
                            if root.send-file-path != "" {
                                root.send-file(root.send-device-address, root.send-file-path);
                                root.send-visible = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── Transfer İlerleme Dialogu ─────────────────────────────────
    if transfer-visible: Rectangle {
        background: #000000aa; x: 0; y: 0; width: root.width; height: root.height;
        Rectangle {
            width: 380px; height: 175px;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: #161b22; border-radius: 12px; border-width: 1px; border-color: #30363d;
            drop-shadow-blur: 24px; drop-shadow-color: #000000cc;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: "Dosya Gönderiliyor"; font-size: 15px; font-weight: 700; color: #e6edf3; horizontal-alignment: center; }
                Text { text: transfer-file; font-size: 12px; color: #8b949e; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    height: 8px; border-radius: 4px; background: #30363d;
                    Rectangle {
                        height: 8px; border-radius: 4px; background: #4a9eff;
                        width: max(8px, root.transfer-progress * parent.width);
                        animate width { duration: 200ms; }
                    }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: transfer-status; font-size: 12px; color: #8b949e; }
                    Text { text: Math.round(transfer-progress * 100) + "%"; font-size: 12px; color: #4a9eff; }
                }
                if transfer-progress >= 1.0 || transfer-status == "Hata": IconBtn {
                    label: "Kapat"; btn-color: #4a9eff; width: 100px; clicked => { root.transfer-visible = false; }
                }
            }
        }
    }

    // ─── Gelen Dosya Dialogu ───────────────────────────────────────
    if incoming-visible: Rectangle {
        background: #000000aa; x: 0; y: 0; width: root.width; height: root.height;
        Rectangle {
            width: 360px; height: 200px;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            background: #161b22; border-radius: 12px; border-width: 1px; border-color: #30363d;
            drop-shadow-blur: 24px; drop-shadow-color: #000000cc;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: "Gelen Dosya"; font-size: 17px; font-weight: 700; color: #e6edf3; horizontal-alignment: center; }
                Text { text: incoming-device; font-size: 13px; color: #4a9eff; horizontal-alignment: center; overflow: elide; }
                HorizontalLayout {
                    alignment: center; spacing: 6px;
                    Text { text: "📄"; font-size: 16px; vertical-alignment: center; }
                    Text { text: incoming-file; font-size: 13px; color: #8b949e; vertical-alignment: center; overflow: elide; }
                }
                Text { text: "~/Bluetooth/ klasörüne kaydedilecek"; font-size: 11px; color: #8b949e; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostBtn { label: "Reddet"; outline-color: #f8514933; width: 140px; clicked => { root.accept-incoming(false); root.incoming-visible = false; } }
                    IconBtn  { label: "Kabul Et"; btn-color: #238636; width: 140px; clicked => { root.accept-incoming(true); root.incoming-visible = false; } }
                }
            }
        }
    }

    // ─── Toast ────────────────────────────────────────────────────
    if toast-visible: Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 60px;
        width: 300px; height: 40px;
        background: #21262d; border-radius: 20px; border-width: 1px; border-color: #30363d;
        drop-shadow-blur: 12px; drop-shadow-color: #000000aa;
        Text { text: toast-text; font-size: 13px; color: #e6edf3; horizontal-alignment: center; vertical-alignment: center; }
    }
}
