# /etc/pam.d/bacak-autologin
#
# PAM policy for the autologin fast-path. No credential prompt: pam_permit
# authenticates, but account/session management still runs so the session is
# registered with logind exactly like an interactive login.

auth     required       pam_env.so
auth     required       pam_permit.so

account  required       pam_unix.so
account  required       pam_nologin.so

password required       pam_deny.so

session  required       pam_loginuid.so
session  required       pam_systemd.so
session  required       pam_limits.so
session  required       pam_unix.so
session  optional       pam_keyinit.so force revoke
session  optional       pam_env.so readenv=1
