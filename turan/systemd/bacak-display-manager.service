# /usr/lib/systemd/system/bacak-display-manager.service
#
# BDM is a display manager: it owns a VT, starts before user login, and is
# mutually exclusive with other display managers via display-manager.service.
[Unit]
Description=Bacak Display Manager
Documentation=man:bacak-display-manager(8)
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service plymouth-quit.service
After=systemd-logind.service
Wants=systemd-logind.service
# Provide the distro's generic display-manager alias so only one DM runs.
Conflicts=plymouth-start.service

[Service]
Type=simple
ExecStart=/usr/bin/bacak-display-manager
# Hand the daemon its own VT; logind allocates the seat.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=XDG_VTNR=1
# Must be root: drives PAM, drops privileges per-session.
User=root
Restart=always
RestartSec=1s
# Keep the daemon's own footprint tight (sessions are spawned as the user and
# are not constrained by these directives).
KillMode=mixed
# logind kills leftover processes from the previous session for us.
ExecStopPost=/usr/bin/loginctl terminate-seat seat0

[Install]
Alias=display-manager.service
WantedBy=graphical.target
