import { ScrollView, LineEdit, Button, CheckBox } from "std-widgets.slint";

// ---- Shared data structures (mirrored from Rust) ----------------------------

export struct EntryModel {
    name: string,
    path: string,
    is-dir: bool,
    is-symlink: bool,
    is-archive: bool,
    size-text: string,
    modified-text: string,
    type-text: string,     // "Klasör", "PNG", "MP4", "APK" …
    glyph: string,
    selected: bool,
    has-icon: bool,
    icon: image,
}

export struct TransferModel {
    id: int,
    label: string,
    status: string,
    detail: string,
    fraction: float,
    paused: bool,
    active: bool,
}

export struct RootModel {
    label: string,
    path: string,
    kind: int,
    glyph: string,
    used-text: string,
    total-text: string,
    fraction: float,
}

export struct VolumeModel {
    object-path: string,
    label: string,
    mounted: bool,
    mount-point: string,
    used-text: string,
    total-text: string,
    fraction: float,
}

export struct ConnModel {
    name: string,
    uri: string,
}

export struct BreadcrumbModel {
    label: string,
    path: string,
}

export struct AppModel {
    id: string,
    name: string,
    is-default: bool,
    has-icon: bool,
    icon: image,
}

export struct DiskUsageModel {
    label: string,
    used-text: string,
    total-text: string,
    fraction: float,
}

// ---- Design tokens ----------------------------------------------------------

export global Theme {
    in-out property <bool> dark: false;
    out property <color> bg:         dark ? #1e1f22 : #f5f5f8;
    out property <color> surface:    dark ? #2b2d31 : #ffffff;
    out property <color> surface-hi: dark ? #383a40 : #ebebef;
    out property <color> accent:     dark ? #4f8cff : #FF8C00;
    out property <color> text:       dark ? #e8e8ea : #1a1a1c;
    out property <color> text-dim:   dark ? #9a9ba0 : #6a6b70;
    out property <length> radius: 12px;
    out property <length> touch-target: 48px;
    out property <length> gap: 8px;
}

export global DragState {
    in-out property <bool> active;
    in-out property <int> source-index: -1;
    in-out property <string> source-path;
    in-out property <string> source-label;
    in-out property <length> px;
    in-out property <length> py;
    in-out property <string> target-path;
}

export global ContextState {
    in-out property <bool> active;
    in-out property <int> index: -1;
    in-out property <bool> is-dir;
    in-out property <bool> is-archive;
    in-out property <length> x;
    in-out property <length> y;
}

export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> shown;
}

