#!/bin/sh
# llama.cpp'yi (Vulkan derlemesi, MIT) ve Qwen3-VL 8B modelini (Apache 2.0)
# indirip kurar. Yaklaşık 6 GB. root olarak çalıştırın.
set -eu
LLAMA_SURUM="${LLAMA_SURUM:-b12144}"
MODEL_DEPO="https://huggingface.co/Qwen/Qwen3-VL-8B-Instruct-GGUF/resolve/main"
MODEL_DIZIN=/var/lib/yzsunucu/model
LLAMA_DIZIN=/opt/yzsunucu/llama

[ "$(id -u)" = 0 ] || { echo "root olarak çalıştırın: sudo $0" >&2; exit 1; }
command -v curl >/dev/null || { echo "curl gerekli: apt install curl" >&2; exit 1; }

gecici=$(mktemp -d)
trap 'rm -rf "$gecici"' EXIT

echo "llama.cpp $LLAMA_SURUM indiriliyor..."
curl -fL --progress-bar -o "$gecici/llama.tar.gz" \
  "https://github.com/ggml-org/llama.cpp/releases/download/$LLAMA_SURUM/llama-$LLAMA_SURUM-bin-ubuntu-vulkan-x64.tar.gz"
mkdir -p "$gecici/llama"
tar -xzf "$gecici/llama.tar.gz" -C "$gecici/llama"
kaynak=$(dirname "$(find "$gecici/llama" -name llama-server -type f | head -1)")
rm -rf "$LLAMA_DIZIN"
mkdir -p "$LLAMA_DIZIN"
cp -a "$kaynak"/. "$LLAMA_DIZIN"/

mkdir -p "$MODEL_DIZIN"
for f in Qwen3VL-8B-Instruct-Q4_K_M.gguf mmproj-Qwen3VL-8B-Instruct-F16.gguf; do
  if [ -s "$MODEL_DIZIN/$f" ]; then
    echo "$f zaten var."
  else
    echo "$f indiriliyor..."
    curl -fL --progress-bar -C - -o "$MODEL_DIZIN/$f.part" "$MODEL_DEPO/$f"
    mv "$MODEL_DIZIN/$f.part" "$MODEL_DIZIN/$f"
  fi
done
chown -R yzsunucu:yzsunucu /var/lib/yzsunucu 2>/dev/null || true

echo "Kuruldu. Başlatmak için: systemctl enable --now yzsunucu"
