[Unit]
Description=YZsunucu (tahta "Sor" kartı için yerel yapay zekâ)
Documentation=file:///usr/share/doc/yzsunucu/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/yzsunucu/llama/llama-server

[Service]
Type=simple
User=yzsunucu
Group=yzsunucu
# GPU erişimi (Vulkan) için.
SupplementaryGroups=video render
ExecStart=/usr/bin/yzsunucu /etc/yzsunucu/yzsunucu.conf
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/yzsunucu
# GPU sürücüsünün gölgelendirici önbelleği için.
Environment=XDG_CACHE_HOME=/var/lib/yzsunucu/.cache
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
