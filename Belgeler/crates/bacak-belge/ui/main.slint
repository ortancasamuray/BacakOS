import { Button, LineEdit, ScrollView } from "std-widgets.slint";

/// One pen/highlighter stroke, in the page's path viewbox (see cizim.rs).
export struct Cizgi {
    komut: string,
    renk: color,
    /// Stroke width as a fraction of the page width.
    kalinlik: float,
}

/// Toolbar button sized for fingers on a touch board, with a text label
/// (emoji glyphs aren't in every font the software renderer finds).
component AracDugmesi inherits Rectangle {
    in property <string> text;
    in property <bool> etkin: true;
    in property <bool> secili: false;
    in property <color> yazi: #d0d0d8;
    callback tiklandi();

    min-width: 40px;
    height: 40px;
    border-radius: 6px;
    background: !etkin ? transparent : secili ? #4a4a78 : dokunma.pressed ? #3a3a52 : dokunma.has-hover ? #2e2e44 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: root.etkin ? (root.secili ? #ffffff : root.yazi) : #66666e;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    dokunma := TouchArea {
        enabled: root.etkin;
        clicked => { root.tiklandi(); }
    }
}

component RenkKutusu inherits Rectangle {
    in property <color> renk;
    in property <bool> secili: false;
    callback secildi(color);

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: renk;
    border-color: secili ? #ffffff : #77778088;
    border-width: secili ? 3px : 1px;
    TouchArea { clicked => { root.secildi(root.renk); } }
}

export component AppWindow inherits Window {
    title: filename == "" ? "Bacak Belge Görüntüleyici" : filename + " — Bacak Belge";
    preferred-width: 1100px;
    preferred-height: 800px;
    min-width: 520px;
    min-height: 420px;

    // "pdf" | "epub" | "image" | "loading" | "error" | "parola" | "bos"
    in property <string> mode: "loading";
    in property <string> filename: "";
    in property <string> status: "";

    // ── PDF & image ───────────────────────────────────────────────────────
    in property <image> content-image;
    /// Logical size of the content at the current zoom (before a pinch).
    in property <length> icerik-w: 0px;
    in property <length> icerik-h: 0px;
    in property <float> zoom: 1.0;
    /// "Sayfa" / "Genişlik" while fitted, empty for a chosen zoom.
    in property <string> sigdir-kipi: "";
    in-out property <float> pinch-scale: 1.0;
    in property <int> page-num: 1;
    in property <int> page-count: 0;
    in-out property <float> pan-x: 0;
    in-out property <float> pan-y: 0;
    private property <float> pan-start-x: 0;
    private property <float> pan-start-y: 0;
    private property <float> zoom-at-start: 1.0;
    /// The view the content is shown in (Rust fits the content to it).
    out property <length> view-w: 0px;
    out property <length> view-h: 0px;

    // ── Notes ─────────────────────────────────────────────────────────────
    in-out property <bool> draw-mode: false;
    in-out property <string> active-tool: "pen";   // "pen" | "marker"
    in property <color> pen-color: #e53935;
    in property <[Cizgi]> cizgiler;
    /// The page's height / width (the strokes' viewbox).
    in property <float> sayfa-oran: 1.414;
    in property <bool> geri-alinabilir: false;
    in property <bool> not-var: false;

    // ── EPUB ──────────────────────────────────────────────────────────────
    in property <string> chapter-title: "";
    in property <string> body-text: "";
    in property <int> font-size: 18;
    in property <bool> dark-mode: false;

    // ── Shared ────────────────────────────────────────────────────────────
    in property <bool> has-prev: false;
    in property <bool> has-next: false;
    in property <string> parola-hatasi: "";

    callback prev-action();
    callback next-action();
    callback first-page();
    callback last-page();
    callback zoom-in();
    callback zoom-out();
    callback fit();
    callback view-resized();
    callback font-larger();
    callback font-smaller();
    callback toggle-dark();
    callback pinch-ended(float);
    callback set-tool(string);
    /// Point as fractions of the page; the page's shown width in logical px.
    callback draw-start(float, float, float);
    callback draw-move(float, float, float);
    callback draw-end();
    callback undo();
    callback clear-annotations();
    callback pick-color(color);
    callback parola-gir(string);
    callback dosya-yoneticisi();

    property <color> epub-bg: dark-mode ? #1a1a2e : #f5f0e8;
    property <color> epub-fg: dark-mode ? #e8e0d0 : #2c2416;
    property <color> epub-bar: dark-mode ? #16213e : #e0dbd0;
    property <bool> sayfali: mode == "pdf" || mode == "image";
    property <length> gosterilen-w: icerik-w * pinch-scale;
    property <length> gosterilen-h: icerik-h * pinch-scale;

    /// Keep the content inside the view (see yerlesim::sinirla).
    pure function sinirla(v: float, icerik: length, gorunum: length) -> float {
        return icerik <= gorunum ? 0 : Math.max(-(icerik - gorunum) / 2px, Math.min((icerik - gorunum) / 2px, v));
    }

    /// Wheel: scroll the page; at its edge, turn to the next/previous page.
    function tekerlek(dx: length, dy: length) {
        if mode == "pdf" && dy < 0 && pan-y <= sinirla(-1000000, gosterilen-h, view-h) + 0.5 && has-next {
            next-action();
            pan-y = sinirla(1000000, gosterilen-h, view-h);
            return;
        }
        if mode == "pdf" && dy > 0 && pan-y >= sinirla(1000000, gosterilen-h, view-h) - 0.5 && has-prev {
            prev-action();
            pan-y = sinirla(-1000000, gosterilen-h, view-h);
            return;
        }
        pan-x = sinirla(pan-x + dx / 1px, gosterilen-w, view-w);
        pan-y = sinirla(pan-y + dy / 1px, gosterilen-h, view-h);
    }

    background: mode == "epub" ? epub-bg : (mode == "image" ? #111111 : #3c3c44);

    tuslar := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "z" || e.text == "Z") { root.undo(); return accept; }
            if e.modifiers.control { return reject; }
            if e.text == Key.Escape && root.draw-mode { root.draw-mode = false; return accept; }
            if e.text == Key.PageDown || e.text == Key.RightArrow || e.text == " " {
                if root.has-next { root.next-action(); }
                return accept;
            }
            if e.text == Key.PageUp || e.text == Key.LeftArrow || e.text == Key.Backspace {
                if root.has-prev { root.prev-action(); }
                return accept;
            }
            if e.text == Key.Home { root.first-page(); return accept; }
            if e.text == Key.End { root.last-page(); return accept; }
            if root.mode == "epub" {
                if e.text == "+" || e.text == "=" { root.font-larger(); return accept; }
                if e.text == "-" { root.font-smaller(); return accept; }
                return reject;
            }
            if root.sayfali {
                if e.text == "+" || e.text == "=" { root.zoom-in(); return accept; }
                if e.text == "-" { root.zoom-out(); return accept; }
                if e.text == "0" { root.fit(); return accept; }
                if e.text == Key.DownArrow { root.tekerlek(0, -80px); return accept; }
                if e.text == Key.UpArrow { root.tekerlek(0, 80px); return accept; }
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // EPUB: book title bar.
            if mode == "epub": Rectangle {
                height: 32px;
                background: epub-bar;
                Text {
                    text: filename;
                    color: epub-fg;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // ── PDF / image ────────────────────────────────────────────────
            if sayfali: Rectangle {
                vertical-stretch: 1;
                clip: true;
                init => { root.view-w = self.width; root.view-h = self.height; root.view-resized(); }
                changed width => { root.view-w = self.width; root.view-resized(); }
                changed height => { root.view-h = self.height; root.view-resized(); }

                ScaleRotateGestureHandler {
                    enabled: !root.draw-mode;
                    started => { root.zoom-at-start = root.zoom; root.pinch-scale = 1.0; }
                    updated => { root.pinch-scale = self.scale; }
                    ended => { root.pinch-ended(root.zoom-at-start * root.pinch-scale); root.pinch-scale = 1.0; }
                    cancelled => { root.pinch-scale = 1.0; }

                    // Drag to pan, wheel to scroll (Ctrl+wheel zooms).
                    TouchArea {
                        enabled: !root.draw-mode && !parent.active;
                        mouse-cursor: root.gosterilen-w > root.view-w || root.gosterilen-h > root.view-h ? move : default;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                root.pan-start-x = self.mouse-x / 1px;
                                root.pan-start-y = self.mouse-y / 1px;
                                tuslar.focus();
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.pan-x = root.sinirla(root.pan-x + (self.mouse-x / 1px - root.pan-start-x), root.gosterilen-w, root.view-w);
                                root.pan-y = root.sinirla(root.pan-y + (self.mouse-y / 1px - root.pan-start-y), root.gosterilen-h, root.view-h);
                                root.pan-start-x = self.mouse-x / 1px;
                                root.pan-start-y = self.mouse-y / 1px;
                            }
                        }
                        scroll-event(e) => {
                            if e.modifiers.control {
                                if e.delta-y > 0 { root.zoom-in(); } else if e.delta-y < 0 { root.zoom-out(); }
                                return accept;
                            }
                            if e.modifiers.shift {
                                root.tekerlek(e.delta-y, 0);
                            } else {
                                root.tekerlek(e.delta-x, e.delta-y);
                            }
                            return accept;
                        }
                    }

                    // The page: picture, notes on it, and the drawing surface.
                    if content-image.width > 0: Rectangle {
                        width: root.gosterilen-w;
                        height: root.gosterilen-h;
                        x: (parent.width - self.width) / 2 + root.pan-x * 1px;
                        y: (parent.height - self.height) / 2 + root.pan-y * 1px;
                        background: mode == "pdf" ? #ffffff : transparent;
                        drop-shadow-blur: mode == "pdf" ? 12px : 0px;
                        drop-shadow-color: #00000066;

                        Image {
                            source: root.content-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }
                        for c in root.cizgiler: Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: 1000;
                            viewbox-height: 1000 * root.sayfa-oran;
                            commands: c.komut;
                            stroke: c.renk;
                            stroke-width: c.kalinlik * parent.width;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                        if root.draw-mode: TouchArea {
                            mouse-cursor: crosshair;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    root.draw-start(self.mouse-x / self.width, self.mouse-y / self.height, self.width / 1px);
                                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    root.draw-end();
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.draw-move(self.mouse-x / self.width, self.mouse-y / self.height, self.width / 1px);
                                }
                            }
                        }
                    }
                    if content-image.width == 0: Text {
                        text: root.status != "" ? root.status : "Yükleniyor…";
                        color: #9a9aa4;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // ── EPUB ───────────────────────────────────────────────────────
            if mode == "epub": sv := ScrollView {
                vertical-stretch: 1;
                // A new chapter starts at its top.
                property <string> metin: root.body-text;
                changed metin => { self.viewport-y = 0; }
                viewport-width: self.visible-width;
                viewport-height: govde.preferred-height + 72px;
                Rectangle {
                    width: sv.viewport-width;
                    height: sv.viewport-height;
                    background: root.epub-bg;
                    govde := Text {
                        // A comfortable line length on wide screens and boards.
                        width: Math.min(sv.visible-width - 64px, 52 * root.font-size * 1px);
                        x: (parent.width - self.width) / 2;
                        y: 36px;
                        text: root.body-text;
                        color: root.epub-fg;
                        font-size: root.font-size * 1px;
                        wrap: word-wrap;
                    }
                }
            }

            // ── PDF password ───────────────────────────────────────────────
            if mode == "parola": Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 24px;
                    Text {
                        text: "Bu belge parolayla korunuyor.";
                        color: #e0e0e8;
                        font-size: 18px;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        parola := LineEdit {
                            width: 280px;
                            input-type: password;
                            placeholder-text: "Belge parolası";
                            init => { self.focus(); }
                            accepted(t) => { root.parola-gir(t); }
                        }
                        Button {
                            text: "Aç";
                            primary: true;
                            clicked => { root.parola-gir(parola.text); }
                        }
                    }
                    if root.parola-hatasi != "": Text {
                        text: root.parola-hatasi;
                        color: #ef6b6b;
                        horizontal-alignment: center;
                    }
                }
            }

            // ── Loading / error / nothing open ─────────────────────────────
            if mode == "loading" || mode == "error" || mode == "bos": Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;
                    padding: 24px;
                    Text {
                        text: mode == "loading" ? "Yükleniyor…" : root.status;
                        color: mode == "error" ? #ef6b6b : #b0b0ba;
                        font-size: 17px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if mode == "bos": HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Dosya yöneticisini aç";
                            primary: true;
                            clicked => { root.dosya-yoneticisi(); }
                        }
                    }
                }
            }

            // ── Toolbar ────────────────────────────────────────────────────
            if mode == "pdf" || mode == "image" || mode == "epub": Rectangle {
                height: 56px;
                background: mode == "epub" ? epub-bar : #1e1e2e;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 4px;

                    AracDugmesi { text: "◀"; etkin: root.has-prev; yazi: mode == "epub" ? root.epub-fg : #d0d0d8; tiklandi => { root.prev-action(); } }
                    if mode == "pdf": Text {
                        text: root.page-num + " / " + root.page-count;
                        color: #d0d0d8;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        min-width: 72px;
                    }
                    AracDugmesi { text: "▶"; etkin: root.has-next; yazi: mode == "epub" ? root.epub-fg : #d0d0d8; tiklandi => { root.next-action(); } }

                    if sayfali: Rectangle { width: 8px; }
                    if sayfali: AracDugmesi { text: "−"; tiklandi => { root.zoom-out(); } }
                    if sayfali: Text {
                        text: Math.round(root.zoom * root.pinch-scale * 100) + "%";
                        color: #a8a8b4;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        min-width: 52px;
                    }
                    if sayfali: AracDugmesi { text: "+"; tiklandi => { root.zoom-in(); } }
                    if sayfali: AracDugmesi {
                        text: root.sigdir-kipi == "Sayfa" ? "Genişliğe sığdır" : "Sayfaya sığdır";
                        tiklandi => { root.fit(); }
                    }

                    if sayfali: Rectangle { width: 8px; }
                    if sayfali: AracDugmesi {
                        text: "Kalem";
                        secili: root.draw-mode && root.active-tool == "pen";
                        tiklandi => { root.set-tool("pen"); }
                    }
                    if sayfali: AracDugmesi {
                        text: "Fosforlu";
                        secili: root.draw-mode && root.active-tool == "marker";
                        tiklandi => { root.set-tool("marker"); }
                    }
                    if root.draw-mode && sayfali: HorizontalLayout {
                        spacing: 6px;
                        padding-left: 4px;
                        padding-right: 4px;
                        alignment: center;
                        for r in [#e53935, #1e88e5, #43a047, #fdd835, #212121, #ffffff]: VerticalLayout {
                            alignment: center;
                            RenkKutusu { renk: r; secili: root.pen-color == r; secildi(c) => { root.pick-color(c); } }
                        }
                    }
                    if sayfali && (root.draw-mode || root.not-var): AracDugmesi {
                        text: "Geri al";
                        etkin: root.geri-alinabilir;
                        tiklandi => { root.undo(); }
                    }
                    if sayfali && (root.draw-mode || root.not-var): AracDugmesi {
                        text: "Notları sil";
                        etkin: root.not-var;
                        yazi: #ef8a8a;
                        tiklandi => { root.clear-annotations(); }
                    }

                    if mode == "epub": AracDugmesi { text: "A−"; yazi: root.epub-fg; tiklandi => { root.font-smaller(); } }
                    if mode == "epub": AracDugmesi { text: "A+"; yazi: root.epub-fg; tiklandi => { root.font-larger(); } }
                    if mode == "epub": AracDugmesi {
                        text: root.dark-mode ? "Açık" : "Koyu";
                        yazi: root.epub-fg;
                        tiklandi => { root.toggle-dark(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: mode == "epub" ? root.chapter-title : root.filename;
                        color: mode == "epub" ? root.epub-fg : #a8a8b4;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    if root.status != "": Text {
                        text: root.status;
                        color: mode == "epub" ? root.epub-fg : #8a8a96;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
