Date: Sun, 25 Oct 2026 21:16:59 +0300
Subject: [PATCH] =?UTF-8?q?debian:=200.5.1+bacak2=20=E2=80=94=20arm64=20pa?=
 =?UTF-8?q?keti?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Vestel OTD (4 kameralı) sunucusu aarch64 olarak da geliyor; paket arm64
için de derlenir. Sunucu uname -m yerine DEB_HOST_GNU_CPU ile seçilir
(çapraz derlemede uname -m ana makineyi verir). Yalnız x86-64 olan 2
kameralı sunucu ve kalibrasyon araçları sadece amd64 paketine girer;
çekirdek başlık bağımlılığı linux-headers-<mimari>.

touchdrv_launcher: OpticalService yoksa temiz çıkar; aksi halde
Restart=on-failure + StartLimitIntervalSec=0 sonsuz döngüye giriyordu.
---
 debian/changelog  | 11 +++++++++++
 debian/control    |  7 +++++--
 debian/rules      | 22 +++++++++++++++++-----
 touchdrv_launcher |  6 ++++++
 4 files changed, 39 insertions(+), 7 deletions(-)

diff --git a/debian/changelog b/debian/changelog
index 2b4e12a..e71f8ff 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,14 @@
+eta-touchdrv (0.5.1+bacak2) stable; urgency=medium
+
+  * BacakOS: build for arm64 as well. Pick the Vestel OTD server by
+    DEB_HOST_GNU_CPU instead of uname -m so cross builds ship the right
+    binary; install the x86-64-only 2-camera server and calibration tools on
+    amd64 only; depend on linux-headers-<arch>.
+  * touchdrv_launcher: exit cleanly when OpticalService is missing instead of
+    failing into an endless Restart=on-failure loop.
+
+ -- Anadolu Panteri <bilgi@anadolupanteri.org.tr>  Sun, 25 Oct 2026 18:00:00 +0300
+
 eta-touchdrv (0.5.1+bacak1) stable; urgency=medium
 
   * BacakOS: depend on linux-headers-amd64 and pahole so DKMS can build the
diff --git a/debian/control b/debian/control
index 51e58f5..007942c 100644
--- a/debian/control
+++ b/debian/control
@@ -9,9 +9,12 @@ Homepage: https://git.pardus.org.tr
 #Vcs-Browser: http://anonscm.debian.org/?p=collab-maint/eta-touchdrv.git;a=summary
 
 Package: eta-touchdrv
-Architecture: amd64
-Depends: ${shlibs:Depends}, ${misc:Depends}, linux-headers-amd64, pahole
+Architecture: amd64 arm64
+Depends: ${shlibs:Depends}, ${misc:Depends}, ${kernel:Depends}, pahole
 Description: Non-HID touchscreen drivers for Fatih IWBs
  These are drivers for non-hid 2-camera and 4-camera touchscreen sensors
  of Fatih Interactive White Boards. Kernel modules are open-source, but
  source code of server daemons are unavailable. They are provided by Vestel.
+ .
+ On arm64 only the 4-camera (OTD) sensors are supported: Vestel ships the
+ 2-camera server and both calibration tools as x86-64 binaries only.
diff --git a/debian/rules b/debian/rules
index 9e72249..72c149c 100755
--- a/debian/rules
+++ b/debian/rules
@@ -2,18 +2,30 @@
 
 VERSION=$(shell dpkg-parsechangelog --show-field=Version|rev|cut -d- -f2-|rev)
 
+# Vestel sunucu programları hazır ikili: hedef mimariye göre seç (uname -m
+# çapraz derlemede ana makineyi verir). touch2 sunucusu ve kalibrasyon
+# araçları yalnız x86-64 olarak var.
+DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
+DEB_HOST_GNU_CPU ?= $(shell dpkg-architecture -qDEB_HOST_GNU_CPU)
+BIN := debian/eta-touchdrv/usr/bin
+
 %:
 	dh $@ --with dkms
 
 override_dh_install:
 	dh_install touch2/kernelSrc/Makefile touch2/kernelSrc/OpticalDrv.c touch2/kernelSrc/OpticalDrv.h usr/src/eta-touchdrv-$(VERSION)/touch2/
-	dh_install touch2/opticServer/OpticalService touch2/calibrationTools/calibrationTools usr/bin/
-	chmod 744 debian/eta-touchdrv/usr/bin/OpticalService debian/eta-touchdrv/usr/bin/calibrationTools
 	dh_install touch4/kernel/Makefile touch4/kernel/OtdDrv.c touch4/kernel/OtdDrv.h usr/src/eta-touchdrv-$(VERSION)/touch4/
-	dh_install touch4/otdServer/OtdTouchServer.$(shell uname -m) touch4/calibration/OtdCalibrationTool usr/bin/
-	chmod 744 debian/eta-touchdrv/usr/bin/OtdTouchServer.$(shell uname -m) debian/eta-touchdrv/usr/bin/OtdCalibrationTool
+	dh_install touch4/otdServer/OtdTouchServer.$(DEB_HOST_GNU_CPU) usr/bin/
+	chmod 744 $(BIN)/OtdTouchServer.$(DEB_HOST_GNU_CPU)
+ifeq ($(DEB_HOST_ARCH),amd64)
+	dh_install touch2/opticServer/OpticalService touch2/calibrationTools/calibrationTools touch4/calibration/OtdCalibrationTool usr/bin/
+	chmod 744 $(BIN)/OpticalService $(BIN)/calibrationTools $(BIN)/OtdCalibrationTool
+endif
 	dh_install touchdrv_launcher usr/bin
-	chmod 744 debian/eta-touchdrv/usr/bin/touchdrv_launcher
+	chmod 744 $(BIN)/touchdrv_launcher
 
 override_dh_dkms:
 	dh_dkms -V $(VERSION)
+
+override_dh_gencontrol:
+	dh_gencontrol -- -Vkernel:Depends=linux-headers-$(DEB_HOST_ARCH)
diff --git a/touchdrv_launcher b/touchdrv_launcher
index eb25b2a..b565815 100755
--- a/touchdrv_launcher
+++ b/touchdrv_launcher
@@ -4,6 +4,12 @@ set -euo pipefail
 TYPE=$1
 
 if [ "$TYPE" = "optical" ]; then
+    # OpticalService yalnız x86-64; arm64'te yok. Restart=on-failure döngüye
+    # girmesin diye temiz çık.
+    if [ ! -x /usr/bin/OpticalService ]; then
+        echo "OpticalService yok: 2 kameralı sensör bu mimaride desteklenmiyor ($(uname -m))"
+        exit 0
+    fi
     modprobe OpticalDrv || true
     exec /usr/bin/OpticalService
 elif [ "$TYPE" = "otd" ]; then
-- 
